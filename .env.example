# Optional: without a key mini-rag uses local, deterministic retrieval and an
# extractive answer. Set this to enable OpenAI embeddings and generated answers.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4.1-mini"

APP_NAME="mini-rag"
APP_VERSION="1.0.0"
DATA_DIR="data"
CHUNK_SIZE="900"
CHUNK_OVERLAP="150"
MAX_UPLOAD_BYTES="5242880"
